# ---------------------------------------------------------------------------
# Private Aviation Tracker — environment configuration
# Copy to .env.local (Next.js) or .env and fill in.
# Every secret in this file is read on the SERVER ONLY. Never prefix an API key
# with NEXT_PUBLIC_ — anything with that prefix is inlined into browser JS.
# ---------------------------------------------------------------------------

# --- Database (required) ---------------------------------------------------
DATABASE_URL="postgresql://tracker:tracker@localhost:5432/private_aviation?schema=public"

# --- Cache (optional; falls back to an in-process LRU when unset) ----------
# REDIS_URL="redis://localhost:6379"

# --- Live ADS-B data source ------------------------------------------------
# Provider selection:
#   adsbexchange   ADS-B Exchange via RapidAPI (primary, recommended)
#   adsbx_direct   ADS-B Exchange direct/enterprise endpoint (api-key header)
#   readsb         Any readsb/tar1090-compatible JSON API (adsb.fi, adsb.lol,
#                  airplanes.live, your own feeder). Set ADSB_BASE_URL.
#   demo           Deterministic *simulated* traffic for local UI work. The UI
#                  shows a permanent "SIMULATED DATA" banner in this mode.
ADSB_PROVIDER="adsbexchange"

# ADS-B Exchange via RapidAPI — https://rapidapi.com/adsbx/api/adsbexchange-com1
ADSBX_RAPIDAPI_KEY=""
ADSBX_RAPIDAPI_HOST="adsbexchange-com1.p.rapidapi.com"

# ADS-B Exchange direct / enterprise (if you hold a direct data agreement).
# Sent as the documented "api-auth" header against the gateway host:
#   GET https://gateway.adsbexchange.com/api/aircraft/v2/icao/A465DF
# ADSBX_API_KEY=""
# ADSBX_BASE_URL="https://gateway.adsbexchange.com/api/aircraft"

# readsb-compatible endpoint, used when ADSB_PROVIDER=readsb.
# Check each provider's terms before pointing at it.
# ADSB_BASE_URL="https://opendata.adsb.fi/api/v2"

# If the provider above has no key, fall back to this open feed so the map
# still shows real aircraft. The UI states which source is in use. Set
# ADSB_OPEN_FEED_FALLBACK=false to show the configuration error instead.
ADSB_OPEN_FEED_FALLBACK="true"
# ADSB_OPEN_FEED_URL="https://opendata.adsb.fi/api/v2"

# Sent on every upstream request. Community feeds ask clients to identify
# themselves — add your contact details if you run this at any volume.
# ADSB_USER_AGENT="PrivateAviationTracker/0.1 (you@example.com)"

# How often the server polls upstream per active map viewport (ms).
# Respect your plan's rate limits — one poll per viewport is shared by all
# connected clients.
# Community feeds rate-limit per client; 10s is safe for them. ADS-B Exchange
# subscribers can lower this. A 429 triggers automatic exponential backoff.
ADSB_POLL_INTERVAL_MS="10000"
# Upstream search radius cap in nautical miles (ADS-B Exchange caps at 250).
ADSB_MAX_RADIUS_NM="250"
# How long one SSE connection is held before a clean rotate-and-reconnect.
# Keep this below your platform's function duration cap (Vercel Hobby: 60s).
ADSB_STREAM_LIFETIME_MS="50000"

# --- Web search provider for ownership research ----------------------------
# google_cse | serpapi | bing | brave | none
SEARCH_PROVIDER="none"

# Google Programmable Search — https://developers.google.com/custom-search
GOOGLE_CSE_API_KEY=""
GOOGLE_CSE_CX=""

# SerpAPI — https://serpapi.com
SERPAPI_KEY=""

# Bing Web Search (Azure)
BING_SEARCH_KEY=""
BING_SEARCH_ENDPOINT="https://api.bing.microsoft.com/v7.0/search"

# Brave Search API
BRAVE_SEARCH_KEY=""

# --- Optional LLM refinement of ownership evidence -------------------------
# When enabled, search snippets are passed to Claude to extract a structured
# owner/operator with evidence. The model is instructed never to guess; if the
# snippets do not support a conclusion it returns "not found".
OWNERSHIP_LLM_ENABLED="false"
ANTHROPIC_API_KEY=""
OWNERSHIP_LLM_MODEL="claude-opus-5"

# --- Ownership cache -------------------------------------------------------
OWNERSHIP_CACHE_TTL_HOURS="168"     # 7 days
OWNERSHIP_NOTFOUND_TTL_HOURS="24"   # retry unresolved registrations sooner

# --- Aircraft photos -------------------------------------------------------
PHOTOS_ENABLED="true"
# auto          Planespotters first (exact tail match), then Google Images
# planespotters aviation database only
# google        Google Images only — broadest coverage, looser match
PHOTO_PROVIDER="auto"
# Google image search reuses GOOGLE_CSE_API_KEY / GOOGLE_CSE_CX unless you set
# a dedicated engine here. The search engine must have Image search enabled.
# GOOGLE_IMAGE_API_KEY=""
# GOOGLE_IMAGE_CSE_CX=""

# --- History persistence ---------------------------------------------------
PERSIST_POSITIONS="true"
POSITION_SAMPLE_INTERVAL_SEC="30"
HISTORY_RETENTION_DAYS="30"

# --- Map (public values — safe to expose) ----------------------------------
# Leave unset for the built-in dark CARTO raster basemap (no key required).
# NEXT_PUBLIC_MAP_STYLE="https://tiles.openfreemap.org/styles/dark"
# NEXT_PUBLIC_MAPTILER_KEY=""
NEXT_PUBLIC_MAP_REFRESH_MS="5000"
# Clustering is on by default: nearby contacts collapse into count bubbles
# below NEXT_PUBLIC_MAP_CLUSTER_MAX_ZOOM and draw individually above it.
# Set to "false" to draw every aircraft separately at every zoom.
NEXT_PUBLIC_MAP_CLUSTER="true"

# --- Filed-route lookup (destination + ETA) --------------------------------
# ADS-B never carries a destination — it broadcasts position only. A route
# source resolves the callsign to a filed route where one is published.
#   adsbdb   free public route database (api.adsbdb.com), no key
#   none     disable; destinations then come only from trajectory estimates,
#            which are always labelled ESTIMATED in the UI
ROUTE_PROVIDER="adsbdb"
# ROUTE_API_URL="https://api.adsbdb.com/v0"
ROUTE_CACHE_TTL_HOURS="168"
ROUTE_MISS_TTL_HOURS="12"

# --- Web & news research ---------------------------------------------------
# Uses SEARCH_PROVIDER above. Results are classified CONFIRMED / REPORTED /
# UNVERIFIED by source authority and cached.
RESEARCH_CACHE_TTL_HOURS="72"
# Query phrasings tried per aircraft when building a photo gallery.
PHOTO_MAX_QUERIES="3"

# --- Keyless aircraft database (owner + photo) -----------------------------
# Public aircraft database keyed on registration, sharing ROUTE_API_URL.
# This is what makes owner lookup, company pages and tail-specific photos work
# with NO API key configured. Set false to rely only on the FAA import and a
# configured SEARCH_PROVIDER.
AIRCRAFT_DB_ENABLED="true"
AIRCRAFT_DB_TTL_HOURS="336"
AIRCRAFT_DB_MISS_TTL_HOURS="24"

# --- Flight cost estimation ------------------------------------------------
COST_CURRENCY="EUR"
# Jet-A price. Set the per-gallon variable instead to work in US gallons —
# it is converted automatically and takes precedence.
COST_FUEL_PRICE_PER_LITRE="1.20"
# COST_FUEL_PRICE_PER_GALLON="4.50"
COST_CREW_PER_HOUR="165"          # per pilot, per block hour
COST_NAV_PER_NM="1.10"            # en-route navigation / ATC
COST_HANDLING_PER_STOP="550"      # FBO handling per movement
COST_ROUTING_FACTOR="1.06"        # great-circle inflation for real routing
COST_CHARTER_MARKUP_LOW="1.35"    # charter price vs operating cost
COST_CHARTER_MARKUP_HIGH="1.85"

# --- Map clustering --------------------------------------------------------
# Aircraft cluster into count bubbles below this zoom and draw individually
# above it. Set NEXT_PUBLIC_MAP_CLUSTER=false to disable clustering entirely.
NEXT_PUBLIC_MAP_CLUSTER_MAX_ZOOM="7"

# --- Serbian aircraft register (DCV) ---------------------------------------
# The Directorate of Civil Aviation publishes its register as documents, not as
# an API, so data is loaded with a structured importer rather than scraped:
#   npm run import:dcv -- --aircraft ./register.csv --operators ./operators.csv
# Set this only if a machine-readable endpoint becomes available.
# DCV_API_URL=""
