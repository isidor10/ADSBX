// Private Aviation Tracker — data model
//
// Five groups of tables:
//   1. Aircraft identity + ownership intelligence (Aircraft, OwnershipRecord)
//   2. Observed movement data (Position, FlightLeg) — only ever written from
//      real ADS-B observations, never synthesised.
//   3. Reference data imported from official public datasets
//      (FaaRegistration, Airport).
//   4. Company intelligence (Company, CompanyAircraft) — derived from
//      ownership records, so every fleet link carries the role it was found
//      under and the confidence of that finding.
//   5. External research (ResearchItem, AircraftPhotoRecord) — everything
//      discovered on the open web, always stored with its source URL, the
//      date it was discovered and how far it can be trusted.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OwnershipStatus {
  PENDING
  RESOLVED
  NOT_FOUND
  BLOCKED
  ERROR
}

enum OwnerKind {
  REGISTERED_OWNER
  OPERATOR
  MANAGEMENT_COMPANY
  CHARTER_OPERATOR
  TRUSTEE
  BENEFICIAL_OWNER
  UNKNOWN
}

enum FlightStatus {
  ACTIVE
  COMPLETED
  STALE
}

/// How a company is connected to an aircraft. Kept distinct because conflating
/// them is the single most damaging error this product can make: an operator
/// is not an owner.
enum FleetRole {
  REGISTERED_OWNER
  BENEFICIAL_OWNER
  OPERATOR
  MANAGEMENT_COMPANY
  CHARTER_OPERATOR
  ASSOCIATED
}

/// How far a piece of externally-sourced information can be trusted.
enum Verification {
  /// Stated by an official registry or the subject's own site.
  CONFIRMED
  /// Reported by a news outlet or established aviation database.
  REPORTED
  /// Forum posts, aggregators, anything uncorroborated.
  UNVERIFIED
}

enum ResearchKind {
  NEWS
  FORUM
  COMPANY_WEBSITE
  OFFICIAL_REGISTRY
  AVIATION_DATABASE
  OTHER
}

enum SubjectType {
  AIRCRAFT
  COMPANY
}

/// Where a destination came from. Nothing may be shown to the user without one
/// of these attached.
enum RouteSource {
  /// Supplied by a route/flight-plan data source keyed on the callsign.
  FLIGHT_DATA
  /// Observed: the aircraft actually landed there.
  OBSERVED
  /// Inferred from the current trajectory. Always labelled as an estimate.
  TRAJECTORY_ESTIMATE
}

model Aircraft {
  id              String   @id @default(cuid())
  registration    String   @unique
  icao24          String?  @unique
  typeCode        String?
  manufacturer    String?
  model           String?
  /// private_jet | business_jet | turboprop | vip | charter | helicopter | military | airliner | other
  category        String?
  serialNumber    String?
  yearBuilt       Int?
  engineCount     Int?
  registryCountry String?
  /// Where the identity fields came from: adsb | faa_registry | type_database | manual
  identitySource  String?
  photoUrl        String?
  photoCredit     String?
  photoLink       String?
  photoCheckedAt  DateTime?
  firstSeenAt     DateTime?
  lastSeenAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  ownership OwnershipRecord?
  positions Position[]
  flights   FlightLeg[]
  companies CompanyAircraft[]
  photos    AircraftPhotoRecord[]

  @@index([typeCode])
  @@index([category])
  @@index([lastSeenAt])
}

/// A company that owns, operates or manages aircraft. Rows are created from
/// resolved ownership records rather than typed in, so a company exists here
/// only because a sourced ownership finding named it.
model Company {
  id   String @id @default(cuid())
  /// URL segment, e.g. "prince-aviation".
  slug String @unique
  /// Display name as found in the sources.
  name String
  /// Upper-cased, suffix-stripped key used for matching ("PRINCE AVIATION").
  matchKey String

  website     String?
  country     String?
  summary     String?
  /// [{ title, url, label, kind }] — provenance for the company record itself.
  sources     Json     @default("[]")
  /// 0-100, the strength of the evidence linking this company to its fleet.
  confidence  Int      @default(0)

  researchedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  aircraft CompanyAircraft[]

  @@index([matchKey])
  @@index([name])
}

/// One company-to-aircraft link, in one role. An aircraft can appear under the
/// same company twice (owner and operator) or under two companies in different
/// roles — which is the normal case in business aviation.
model CompanyAircraft {
  id           String    @id @default(cuid())
  companyId    String
  aircraftId   String
  registration String
  role         FleetRole

  /// Where the link came from: faa_registry | ownership_search | feed_operator
  source       String?
  sourceUrl    String?
  confidence   Int       @default(0)
  discoveredAt DateTime  @default(now())
  verifiedAt   DateTime?

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  aircraft Aircraft @relation(fields: [aircraftId], references: [id], onDelete: Cascade)

  @@unique([companyId, registration, role])
  @@index([registration])
  @@index([companyId])
}

/// A link discovered on the open web about an aircraft or a company. Stored
/// with its verification level so the UI never presents a forum post as fact.
model ResearchItem {
  id          String       @id @default(cuid())
  subjectType SubjectType
  /// Registration for aircraft, slug for companies.
  subjectKey  String
  title       String
  url         String
  host        String
  snippet     String?
  kind        ResearchKind @default(OTHER)
  verification Verification @default(UNVERIFIED)
  /// Publication date when the source exposes one; null is honest, not zero.
  publishedAt DateTime?
  provider    String?
  query       String?
  discoveredAt DateTime    @default(now())
  lastSeenAt   DateTime    @default(now())

  @@unique([subjectType, subjectKey, url])
  @@index([subjectType, subjectKey, publishedAt])
}

/// Photographs found for a tail number. Only the source URL and thumbnail are
/// kept — images are hot-linked to their origin with attribution, never
/// re-hosted.
model AircraftPhotoRecord {
  id           String   @id @default(cuid())
  aircraftId   String?
  registration String
  url          String
  thumbnailUrl String?
  credit       String?
  /// Page the photo appears on, for attribution and click-through.
  link         String?
  source       String
  /// True only when the source keyed the image on this exact registration.
  /// False means it is a type reference and must be labelled as one.
  verified     Boolean  @default(false)
  width        Int?
  height       Int?
  rank         Int      @default(0)
  discoveredAt DateTime @default(now())

  aircraft Aircraft? @relation(fields: [aircraftId], references: [id], onDelete: SetNull)

  @@unique([registration, url])
  @@index([registration, rank])
}

/// A record copied from an official national aircraft register.
///
/// Kept separate from OwnershipRecord because it is a different kind of claim:
/// OwnershipRecord is a researched conclusion drawn from many sources, this is
/// a transcription of what an official register states. Where both exist the
/// register wins, and a disagreement between them is shown to the user rather
/// than silently resolved.
model RegistryRecord {
  id           String @id @default(cuid())
  registration String
  /// Issuing authority, e.g. "DCV" (Directorate of Civil Aviation, Serbia).
  authority    String

  aircraftType String?
  manufacturer String?
  model        String?
  serialNumber String?
  yearBuilt    Int?
  /// The holder as printed in the register — owner and holder are not always
  /// the same party, so the register's own wording is preserved.
  registeredHolder String?
  holderAddress    String?
  operator     String?
  /// Certificate of airworthiness / registration status as published.
  status       String?

  sourceUrl    String?
  /// Where the row came from: dcv_import | dcv_api | manual
  sourceKind   String   @default("dcv_import")
  /// 0-100. An official register transcription starts high.
  confidence   Int      @default(95)
  verifiedAt   DateTime @default(now())
  importedAt   DateTime @default(now())
  /// Raw source row, kept so a transcription can always be audited.
  raw          Json?

  @@unique([authority, registration])
  @@index([registration])
  @@index([operator])
}

/// An Air Operator Certificate holder, as published by a civil aviation
/// authority. Presence in this table is the only thing that may produce
/// "AOC: YES" — operating an aircraft never implies one.
model AocRecord {
  id        String @id @default(cuid())
  authority String
  /// Normalised name for matching, see companyMatchKey().
  matchKey  String
  name      String

  aocNumber      String?
  /// As published, e.g. "javni avio-prevoz".
  operationType  String?
  operatingLicence String?
  principalPlace String?
  status         String?
  validFrom      DateTime?
  validUntil     DateTime?

  sourceUrl  String?
  sourceKind String   @default("dcv_import")
  confidence Int      @default(95)
  verifiedAt DateTime @default(now())
  importedAt DateTime @default(now())
  raw        Json?

  @@unique([authority, matchKey])
  @@index([matchKey])
  @@index([name])
}

/// An owner or operator role held over a period. Written only when a source
/// states the change; absent history is left absent rather than inferred.
model HistoricalRole {
  id           String    @id @default(cuid())
  registration String
  /// OWNER | OPERATOR | MANAGEMENT
  role         String
  name         String
  fromDate     DateTime?
  toDate       DateTime?
  current      Boolean   @default(false)

  source     String
  sourceUrl  String?
  confidence Int      @default(50)
  recordedAt DateTime @default(now())

  @@unique([registration, role, name, fromDate])
  @@index([registration, role])
}

model OwnershipRecord {
  id           String @id @default(cuid())
  aircraftId   String @unique
  registration String @unique

  owner             String?
  ownerKind         OwnerKind @default(UNKNOWN)
  operator          String?
  managementCompany String?
  charterOperator   String?

  status                   OwnershipStatus @default(PENDING)
  /// 0-100
  confidence               Int             @default(0)
  /// high | medium | low | none
  confidenceBand           String          @default("none")
  beneficialOwnerConfirmed Boolean         @default(false)

  summary  String?
  evidence String?
  /// [{ title, url, provider, kind, weight }]
  sources  Json    @default("[]")
  /// Search queries actually issued, for auditability
  queries  Json    @default("[]")

  searchProvider String?
  analyzer       String?
  errorMessage   String?

  searchedAt     DateTime @default(now())
  lastVerifiedAt DateTime @default(now())
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  aircraft Aircraft @relation(fields: [aircraftId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([owner])
  @@index([operator])
}

model Position {
  id           String   @id @default(cuid())
  aircraftId   String
  registration String
  icao24       String?
  callsign     String?
  lat          Float
  lon          Float
  altBaroFt    Int?
  altGeomFt    Int?
  groundSpeedKt Float?
  trackDeg     Float?
  verticalRateFpm Int?
  squawk       String?
  onGround     Boolean  @default(false)
  source       String?
  seenAt       DateTime
  flightLegId  String?

  aircraft  Aircraft   @relation(fields: [aircraftId], references: [id], onDelete: Cascade)
  flightLeg FlightLeg? @relation(fields: [flightLegId], references: [id], onDelete: SetNull)

  @@index([registration, seenAt])
  @@index([flightLegId, seenAt])
  @@index([seenAt])
}

model FlightLeg {
  id           String       @id @default(cuid())
  aircraftId   String
  registration String
  callsign     String?
  status       FlightStatus @default(ACTIVE)

  departureIcao String?
  departureName String?
  departureLat  Float?
  departureLon  Float?
  departedAt    DateTime?

  arrivalIcao String?
  arrivalName String?
  arrivalLat  Float?
  arrivalLon  Float?
  arrivedAt   DateTime?

  /// Destination while the leg is still airborne. Separate from arrival* so an
  /// estimate can never be mistaken for an observed landing: arrival* is only
  /// written once the aircraft is actually on the ground there.
  destinationIcao       String?
  destinationName       String?
  destinationLat        Float?
  destinationLon        Float?
  destinationSource     RouteSource?
  /// 0-100 for an estimate; a flight-data destination is stored at 100.
  destinationConfidence Int?
  destinationEta        DateTime?
  destinationUpdatedAt  DateTime?

  maxAltitudeFt   Int?
  maxGroundSpeedKt Float?
  distanceNm      Float?
  durationSec     Int?

  firstSeenAt DateTime
  lastSeenAt  DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  aircraft  Aircraft   @relation(fields: [aircraftId], references: [id], onDelete: Cascade)
  positions Position[]

  @@index([registration, firstSeenAt])
  @@index([status])
}

/// Subset of the FAA Releasable Aircraft Database (public domain, published by
/// the US FAA). Populated by `npm run import:faa`.
model FaaRegistration {
  nNumber        String    @id
  serialNumber   String?
  mfrMdlCode     String?
  engMfrMdlCode  String?
  yearMfr        Int?
  /// 1=Individual 2=Partnership 3=Corporation 4=Co-Owned 5=Government
  /// 7=LLC 8=Non Citizen Corporation 9=Non Citizen Co-Owned
  registrantType String?
  registrantName String?
  street         String?
  city           String?
  state          String?
  zipCode        String?
  country        String?
  lastActionDate DateTime?
  certIssueDate  DateTime?
  statusCode     String?
  modeSHex       String?
  fractionalOwner Boolean  @default(false)
  expirationDate DateTime?
  manufacturer   String?
  model          String?
  aircraftType   String?
  engineType     String?
  importedAt     DateTime  @default(now())

  @@index([registrantName])
  @@index([modeSHex])
}

/// Airport reference data. A curated core set ships with the app; the full
/// OurAirports dataset can be imported with `npm run import:airports`.
model Airport {
  icao        String  @id
  iata        String?
  name        String
  city        String?
  country     String?
  lat         Float
  lon         Float
  elevationFt Int?
  type        String?

  @@index([iata])
  @@index([lat, lon])
}
