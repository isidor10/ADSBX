# ── Claude API ────────────────────────────────────────────────────────────────
# Obavezno. Model koji sistem koristi je claude-opus-5.
ANTHROPIC_API_KEY=sk-ant-...

# Nivo truda modela: low | medium | high | xhigh | max
# Za poreska pitanja preporuka je "high" (tačnost je važnija od brzine).
AI_EFFORT=high

# ── Baza ──────────────────────────────────────────────────────────────────────
# Dev: SQLite. Produkcija: postavite Postgres URL i promenite provider u
# prisma/schema.prisma na "postgresql".
DATABASE_URL="file:./pravna-baza.db"

# ── Embeddings (opciono) ──────────────────────────────────────────────────────
# Bez ovoga sistem radi samo leksičku (BM25) pretragu — degradira, ali radi.
# Podržano: voyage | openai | none
EMBEDDINGS_PROVIDER=none
VOYAGE_API_KEY=
OPENAI_API_KEY=

# ── Web pretraga ──────────────────────────────────────────────────────────────
# Podrazumevano se koristi ugrađeni web_search alat Claude API-ja.
# Uključite/isključite pretragu zvaničnih izvora u realnom vremenu.
WEB_SEARCH_ENABLED=true
WEB_SEARCH_MAX_USES=8

# ── Sesije ────────────────────────────────────────────────────────────────────
# Tajna za potpisivanje sesijskih kolačića. Generišite: openssl rand -hex 32
SESSION_SECRET=promeni-me-obavezno-u-produkciji

# ── Ostalo ────────────────────────────────────────────────────────────────────
# Maksimalna veličina uploada u megabajtima.
MAX_UPLOAD_MB=20

# ── Ko sme da koristi aplikaciju ──────────────────────────────────────────────
# Svako pitanje troši ANTHROPIC_API_KEY. Objavljena aplikacija bez ograničenja
# znači da svako ko sazna adresu troši vaš novac, i to se ne primeti do fakture.
#
# Zato je podrazumevano: lokalno otvoreno, u produkciji zatvoreno.
# PRISTUP=otvoren   — svako može da pita, bez naloga (samo za lokalni rad)
# PRISTUP=zatvoren  — potrebna prijava
PRISTUP=

# Ko sme da OTVORI nalog. Prvi korisnik je uvek izuzet i postaje administrator.
# Pozivni kod koji delite zaposlenima:
KOD_ZA_REGISTRACIJU=
# Dozvoljeni domeni email adrese, odvojeni zarezom (npr. firma.rs,firma.com):
DOZVOLJENI_DOMENI=
