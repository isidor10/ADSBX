# ── Claude API ────────────────────────────────────────────────────────────────
# Obavezno. Model koji sistem koristi je claude-opus-5.
ANTHROPIC_API_KEY=sk-ant-...

# Nivo truda modela: low | medium | high | xhigh | max
# Za poreska pitanja preporuka je "high" (tačnost je važnija od brzine).
AI_EFFORT=high

# ── Baza ──────────────────────────────────────────────────────────────────────
# Dev: SQLite. Produkcija: postavite Postgres URL i promenite provider u
# prisma/schema.prisma na "postgresql".
DATABASE_URL="file:./pravna-baza.db"

# ── Embeddings (opciono) ──────────────────────────────────────────────────────
# Bez ovoga sistem radi samo leksičku (BM25) pretragu — degradira, ali radi.
# Podržano: voyage | openai | none
EMBEDDINGS_PROVIDER=none
VOYAGE_API_KEY=
OPENAI_API_KEY=

# ── Web pretraga ──────────────────────────────────────────────────────────────
# Podrazumevano se koristi ugrađeni web_search alat Claude API-ja.
# Uključite/isključite pretragu zvaničnih izvora u realnom vremenu.
WEB_SEARCH_ENABLED=true
WEB_SEARCH_MAX_USES=8

# ── Sesije ────────────────────────────────────────────────────────────────────
# Tajna za potpisivanje sesijskih kolačića. Generišite: openssl rand -hex 32
SESSION_SECRET=promeni-me-obavezno-u-produkciji

# ── Ostalo ────────────────────────────────────────────────────────────────────
# Maksimalna veličina uploada u megabajtima.
MAX_UPLOAD_MB=20
